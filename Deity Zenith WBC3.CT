<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
<CheatEntry><ID>49</ID><Description>"Deity Zenith - Enable"</Description><Options moHideChildren="1"/><VariableType>Auto Assembler Script</VariableType><AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
DZ = DZ or {}
local D = DZ
if D.stop then pcall(D.stop) end
D.EXE = 'Battlecry III.exe'
D.SESSION_CAP = 300
D.BSESSION_CAP = 150

-- 1) attach
local pid = getProcessIDFromProcessName(D.EXE)
if pid == nil or pid == 0 then
  messageDialog('Start Warlords Battlecry 3 first.', mtInformation, mbOK)
  error('Deity Zenith: game not running')
end
if getOpenedProcessID() ~= pid then pcall(openProcess, pid) end

local function noAccess()
  messageDialog('Run Cheat Engine as administrator (the game runs as admin).', mtError, mbOK)
  error('Deity Zenith: cannot access the game process')
end
local function canRead()
  if getOpenedProcessID() ~= pid then return false end
  local b = readBytes(0x00400000, 2, true)      -- 'MZ' header of the game exe
  return b ~= nil and #b == 2 and b[1] == 0x4D and b[2] == 0x5A
end
-- attach can be asynchronous: retry reads for up to ~2 seconds before deciding
local readable = canRead()
for i = 1, 20 do
  if readable then break end
  if getOpenedProcessID() ~= pid then pcall(openProcess, pid) end
  if sleep then sleep(100) end
  readable = canRead()
end
if not readable then noAccess() end

-- 2) verify this exact game build (all patched / called sites)
local CHECKS = {
  {0x00458BB0, {0xA1,0x4C,0x7D,0xA2,0x00,0x8A,0x88,0x75,0x4A,0x04,0x00}}, -- frame hook site
  {0x004B1170, {0x81,0xEC,0x04,0x04,0x00,0x00,0x53,0x56,0x57,0x8B,0xD9}}, -- send game message
  {0x0049EB60, {0x81,0xEC,0x5C,0x01,0x00,0x00,0x53,0x56}},               -- message dispatcher
  {0x004A5CA0, {0x66,0x8B,0x44,0x24,0x04,0x8B,0x0D,0x00,0x91,0x70,0x00}}, -- side control check
  {0x0040A8B0, {0x56,0x66,0x8B,0x35,0x14,0x3F,0x6E,0x00}},               -- unit code lookup
  {0x004386A3, {0x68,0x60,0xEB,0x49,0x00,0x8D,0x54,0x24,0x24,0x6A,0x3C,0x52,0x68,0xFA,0x00,0x00,0x00,0x6A,0x01,0xE8}}, -- game's own spawn call
