{$lua}
if syntaxcheck then return end
if DZ and DZ.levelUp then pcall(DZ.levelUp) end
local t = createTimer(nil, false)
t.Interval = 150
t.OnTimer = function(s)
  s.destroy()
  local al = getAddressList()
  if al == nil then return end
  for i = 0, al.Count - 1 do
    local r = al[i]
    if r.Description == 'Level Script' and r.Active then r.Active = false end
  end
end
t.Enabled = true
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
{$asm}
