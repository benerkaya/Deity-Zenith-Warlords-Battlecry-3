  {0x0058BBA4, {0x66,0xFF,0x47,0x0A}},                                    -- army counter ++
  {0x0058C5B8, {0x66,0xFF,0x49,0x0A}},                                    -- army counter --
  {0x0049F518, {0x83,0xC6,0x02,0xB9,0x09,0x00,0x00,0x00,0x8D,0x7C,0x24,0x14,0x8D,0x44,0x24,0x14,0xF3,0xA5,0x50,0xE8,0xD0,0x7C,0x00,0x00}}, -- dispatcher: building message -&gt; 0x4A7200
  {0x004A7200, {0x81,0xEC,0x80,0x00,0x00,0x00,0x53,0x56,0x8B,0xB4,0x24,0x8C,0x00,0x00,0x00,0x83,0x3E,0xFF}}, -- create-building handler (id -1 branch)
  {0x004A7180, {0x51,0x56,0x8B,0x74,0x24,0x0C,0x8D,0x44,0x24,0x0C,0x8D,0x4C}}, -- placement check + id assignment
  {0x004A71B7, {0xE8,0x44,0xE7,0xF8,0xFF}},                               -- call placement check 0x435900
  {0x004A71F0, {0x68,0xF9,0x01,0x00,0x00,0x6A,0x00,0xE8,0x74,0x9F,0x00,0x00}}, -- game's own building send
  {0x0040AA50, {0x56,0x66,0x8B,0x35,0x50,0x77,0x69,0x00}},               -- building code lookup
  {0x0058BC54, {0x66,0xFF,0x47,0x0C}},                                    -- building counter ++
  {0x0058C5F8, {0x66,0xFF,0x49,0x0C}},                                    -- building counter --
  {0x0058B9AB, {0x66,0xFF,0x47,0x02}},                                    -- building slot counter ++
  {0x0058C555, {0x66,0xFF,0x49,0x02}},                                    -- building slot counter --
  {0x00527100, {0x83,0xEC,0x5C,0x56,0x8B,0xF1,0x57,0x8A,0x86,0xB4,0x00,0x00,0x00,0x84,0xC0}}, -- unit gains XP (hero flag +B4)
  {0x005271B3, {0x8A,0x86,0xCD,0x01,0x00,0x00,0x84,0xC0}},               -- XP: no-XP flag +1CD (titans)
  {0x005271E7, {0x8B,0x47,0x34,0x51,0x8D,0x4E,0x3C,0x51,0x50,0xE8,0x2B,0x68,0xEE,0xFF}}, -- XP: level/xp at unit+3C
  {0x0040DA20, {0x0F,0xBF,0x44,0x24,0x0C,0x53,0x55,0x56,0x8B,0x74,0x24,0x14,0x57,0x33,0xED,0x8B,0x7E,0x04,0x66,0x8B,0x0E}}, -- level-up loop
  {0x0040DA5F, {0x8B,0x7E,0x04,0x0F,0xBF,0xD0,0x3B,0x3C,0x95,0x50,0xBC,0x5F,0x00,0x7C,0x04,0x45,0x41,0xEB,0x05,0x66,0x3B,0xC1,0x7D,0x07,0x40,0x66,0x3D,0x13,0x00,0x7C,0xDC}}, -- XP table use, cap
  {0x005FBC50, {0x05,0x00,0x00,0x00,0x0A,0x00,0x00,0x00,0x14,0x00,0x00,0x00,0x28,0x00,0x00,0x00,0x46,0x00,0x00,0x00,0x6E,0x00,0x00,0x00,0xA0,0x00,0x00,0x00,0xDC,0x00,0x00,0x00,0x18,0x01,0x00,0x00,0x5E,0x01,0x00,0x00,0xAE,0x01,0x00,0x00,0x08,0x02,0x00,0x00,0x62,0x02,0x00,0x00,0xBC,0x02,0x00,0x00,0x20,0x03,0x00,0x00,0x84,0x03,0x00,0x00,0x4C,0x04,0x00,0x00,0x14,0x05,0x00,0x00,0xDC,0x05,0x00,0x00}}, -- XP per level
  {0x00531720, {0x8B,0x01,0xC3}},                                         -- selection head
  {0x005317B0, {0x8B,0x09,0x33,0xC0,0x85,0xC9,0x74,0x08,0x8B,0x49,0x1C,0x40,0x85,0xC9,0x75,0xF8,0xC3}}, -- selection next = +1C
  {0x00519880, {0x66,0x8B,0x41,0x28,0xC3}},                               -- object type (0 = army unit)
  {0x00526D80, {0x8A,0x81,0xB4,0x00,0x00,0x00,0x84,0xC0}},               -- level getter (hero flag)
  {0x00526DAB, {0x66,0x8B,0x41,0x3C,0xC3}},                               -- level getter (unit+3C)
}
for _, c in ipairs(CHECKS) do
  local b = readBytes(c[1], #c[2], true)
  if b == nil or #b ~= #c[2] then noAccess() end   -- unreadable = access problem, not a version mismatch
  local ok = true
  if ok then for i = 1, #c[2] do if b[i] ~= c[2][i] then ok = false break end end end
  if not ok then
    messageDialog('This game version is not supported.', mtError, mbOK)
    error('Deity Zenith: unsupported game version')
  end
end
local iat = readInteger(0x005EA1F0)
if iat == nil then noAccess() end
if iat == 0 then
  messageDialog('This game version is not supported.', mtError, mbOK)
  error('Deity Zenith: unsupported game version')
end

