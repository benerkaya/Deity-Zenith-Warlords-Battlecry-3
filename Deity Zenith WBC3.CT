label(dzmx)
label(dzmy)
label(dzctx)
label(dzcty)
label(dzoffx)
label(dzoffy)
label(dztw)
label(dzth)
label(dzfine)
label(dzguard)
label(dzcap)
label(dzframes)
label(dzlast)
label(dzsent)
label(dzpl)
label(dzbld)
label(dzbside_ok)
label(dzbf2)
