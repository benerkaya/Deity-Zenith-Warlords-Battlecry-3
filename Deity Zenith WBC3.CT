label(dzlhero)
label(dzlvdone)
label(dzlf3)
label(dzlg_ok)
label(dzlcopy)
label(dzlcopied)
label(dzlloop)
label(dzlnothero)
label(dzldone)
label(dzlbuf)
label(dzlclamp_ok)
registersymbol(dzreq)
registersymbol(dzpick)
registersymbol(dzside)
registersymbol(dzsidev)
registersymbol(dzcount)
registersymbol(dzwhere)
registersymbol(dzkey)
registersymbol(dzcode)
registersymbol(dzx)
registersymbol(dzy)
registersymbol(dzmx)
registersymbol(dzmy)
registersymbol(dzctx)
registersymbol(dzcty)
registersymbol(dzoffx)
registersymbol(dzoffy)
registersymbol(dztw)
registersymbol(dzth)
registersymbol(dzfine)
registersymbol(dzguard)
registersymbol(dzcap)
registersymbol(dzframes)
registersymbol(dzlast)
registersymbol(dzsent)
registersymbol(dzbreq)
registersymbol(dzbpick)
registersymbol(dztype)
registersymbol(dzbcode)
registersymbol(dzbx)
registersymbol(dzby)
registersymbol(dzbcap)
registersymbol(dzblast)
registersymbol(dzbsent)
registersymbol(dzbside)
registersymbol(dzlreq)
registersymbol(dzlpick)
registersymbol(dzlvl)
registersymbol(dzlkey)
registersymbol(dzllast)
registersymbol(dzlcnt)
registersymbol(dzlsel)
registersymbol(dzlhero)

dzmem:
dzhook:
  pushad
  pushfd
  cld
  inc dword ptr [dzframes]
  push dzmx                      // POINT {dzmx, dzmy}
  call dword ptr [005EA1F0]      // GetCursorPos via the game's import (stdcall)
  // ================= level-up request (all selected units, one frame) =================
  cmp dword ptr [dzlreq],0
  je dzlvdone
  mov dword ptr [dzlreq],0
  mov dword ptr [dzlcnt],0
  mov dword ptr [dzlsel],0
  mov dword ptr [dzlhero],0
  cmp dword ptr [0074C400],0     // map
  je dzlf3
  mov eax,[00AFD4CC]             // unit manager; [mgr+0] = selection list head
  test eax,eax
  je dzlf3
  cmp dword ptr [dzguard],0
  je dzlg_ok
  cmp dword ptr [0060C368],1     // map view active
  jne dzlf3
dzlg_ok:
  mov esi,[eax]
  xor ebx,ebx
dzlcopy:                         // copy the list first (max 64), then work on the copy
  test esi,esi
  je dzlcopied
  cmp ebx,#64
  jae dzlcopied
  mov [ebx*4+dzlbuf],esi
  inc ebx
  mov esi,[esi+1C]               // next selected object
  jmp dzlcopy
dzlcopied:
  xor edi,edi
dzlloop:
  cmp edi,ebx
  jae dzldone
  mov esi,[edi*4+dzlbuf]
  inc edi
  mov ecx,esi
  mov eax,[esi]
  call dword ptr [eax+28]        // object type, as the game asks it (0 = army unit)
  test ax,ax
  jne dzlloop
  inc dword ptr [dzlsel]
  cmp byte ptr [esi+B4],0        // hero: levels through the hero record, skip
  je dzlnothero
  inc dword ptr [dzlhero]
  jmp dzlloop
dzlnothero:
  cmp byte ptr [esi+1CD],0       // titans never gain XP
  jne dzlloop
  cmp dword ptr [esi+24],0       // army object
  je dzlloop
  mov edx,[dzlvl]                // target level, 0-based (0..19)
  cmp edx,#19
  jle dzlclamp_ok
  mov edx,#19
dzlclamp_ok:
  movsx eax,word ptr [esi+3C]    // current level, 0-based
  cmp eax,edx
  jge dzlloop                    // only raise
  mov eax,[edx*4+005FBC4C]       // XP needed for that level (table at 0x5FBC50)
  sub eax,[esi+40]               // minus current XP
  jle dzlloop
  push eax
  mov ecx,esi
  call 00527100                  // the game's own "unit gains XP": levels, stat gains, heal, effects
  inc dword ptr [dzlcnt]
  jmp dzlloop
dzldone:
  mov dword ptr [dzllast],1
  cmp dword ptr [dzlcnt],0
  jne dzlvdone
  mov dword ptr [dzllast],2      // no unit selected
  cmp dword ptr [dzlsel],0
  je dzlvdone
  mov dword ptr [dzllast],5      // only heroes selected
  mov eax,[dzlsel]
  cmp eax,[dzlhero]
  je dzlvdone
  mov dword ptr [dzllast],4      // already at or above that level
  jmp dzlvdone
dzlf3:
  mov dword ptr [dzllast],3
dzlvdone:
  cmp dword ptr [dzreq],0
  jle dzbld
  // --- game state guards ---
  cmp dword ptr [0074C400],0     // map
  je dzf3
  cmp dword ptr [00A27D5C],0     // message system
  je dzf3
  cmp dword ptr [00AFD4CC],0     // unit table
  je dzf3
  cmp dword ptr [dzguard],0
  je dzside_ok_pre
  cmp dword ptr [0060C368],1     // map view active
  jne dzf3
dzside_ok_pre:
  // --- army pool cap (pool is 1000) ---
  mov eax,[059603D0]             // object manager
  test eax,eax
  je dzf3
  movzx ecx,word ptr [eax+0A]    // live army objects
  cmp ecx,[dzcap]
  jae dzf4
  movzx ecx,word ptr [eax]       // live unit objects
  cmp ecx,[dzcap]
  jae dzf4
  // --- unit code must exist ---
  push dword ptr [dzcode]
  call 0040A8B0
  add esp,4
  test eax,eax
  js dzf5
  // --- side: -1 = my side ---
  mov eax,[dzside]
  cmp eax,FFFFFFFF
  jne dzside_ok
  mov eax,[00709100]
dzside_ok:
  cmp eax,6
  ja dzf2
  mov [dzsidev],eax
  push eax
  call 004A5CA0                  // same check the game does before its own spawn
  add esp,4
  test al,al
  je dzf2
  // --- build the 60-byte create-army payload (mirrors 0x4382D0) ---
  mov edi,dzpl
  xor eax,eax
  mov ecx,10
  rep stosd
  mov dword ptr [dzpl],FFFFFFFF  // id -1: game assigns id and finds a free tile
  mov eax,[dzsidev]
  mov [dzpl+04],eax
  mov eax,[dzcode]
  mov [dzpl+08],eax
  mov ax,[dzx]
  mov [dzpl+0C],ax
  mov ax,[dzy]
  mov [dzpl+0E],ax
  mov word ptr [dzpl+2B],FFFF
  mov word ptr [dzpl+2D],FFFF
  mov byte ptr [dzpl+38],FF
  // --- send it exactly like the game (0x438696..0x4386B6) ---
  push 1
  push 0
  push 0
  push 0
  push 1
  push 0049EB60
  push 3C
  push dzpl
  push FA
  push 1
  mov ecx,[00A27D5C]
  call 004B1170
  dec dword ptr [dzreq]
  inc dword ptr [dzsent]
  mov dword ptr [dzlast],1
  jmp dzbld
dzf2:
  mov dword ptr [dzlast],2
  mov dword ptr [dzreq],0
  jmp dzbld
dzf3:
  mov dword ptr [dzlast],3
  mov dword ptr [dzreq],0
  jmp dzbld
dzf4:
  mov dword ptr [dzlast],4
  mov dword ptr [dzreq],0
  jmp dzbld
dzf5:
  mov dword ptr [dzlast],5
  mov dword ptr [dzreq],0
  // ================= building request (one per frame) =================
dzbld:
  cmp dword ptr [dzbreq],0
  jle dzskip
  cmp dword ptr [0074C400],0     // map
  je dzbf3
  cmp dword ptr [00A27D5C],0     // message system
  je dzbf3
  cmp dword ptr [00AFD4CC],0     // unit/side table (id allocation)
  je dzbf3
  cmp dword ptr [dzguard],0
  je dzbguard_ok
  cmp dword ptr [0060C368],1     // map view active
  jne dzbf3
dzbguard_ok:
  // --- building pool cap (pool is 500; the handler does not null-check a full pool) ---
  mov eax,[059603D0]             // object manager
  test eax,eax
  je dzbf3
  movzx ecx,word ptr [eax+0C]    // live building objects
  cmp ecx,[dzbcap]
  jae dzbf4
  movzx ecx,word ptr [eax+02]    // live building slots
  cmp ecx,[dzbcap]
  jae dzbf4
  // --- building code must exist in the building table ---
  push dword ptr [dzbcode]
  call 0040AA50
  add esp,4
  test eax,eax
  je dzbf5
  // --- side: -1 = my side ---
  mov eax,[dzside]
  cmp eax,FFFFFFFF
  jne dzbside_ok
  mov eax,[00709100]
dzbside_ok:
  cmp eax,6
  ja dzbf2
  mov [dzbside],eax
  push eax
  call 004A5CA0
  add esp,4
  test al,al
  je dzbf2
  // --- 36-byte create-building payload (same layout the game sends at 0x4AB2CA / 0x4A71F0) ---
  mov edi,dzbpl
  xor eax,eax
  mov ecx,9
  rep stosd
  mov dword ptr [dzbpl],FFFFFFFF // id -1: game checks the footprint (0x435900), assigns an id, re-sends
  mov eax,[dzbside]
  mov [dzbpl+04],eax
  mov eax,[dzbcode]
  mov [dzbpl+08],eax
  mov ax,[dzbx]
  mov [dzbpl+0C],ax
  mov ax,[dzby]
  mov [dzbpl+0E],ax
  // +1C effect = 0, +20 lifetime = 0 (permanent)
  push 1
  push 0
  push 0
  push 0
  push 1
  push 0049EB60
  push 24
  push dzbpl
  push 1F9
  push 1
  mov ecx,[00A27D5C]
  call 004B1170
  mov dword ptr [dzbreq],0
  inc dword ptr [dzbsent]
  mov dword ptr [dzblast],0A     // sent; Lua turns this into Built / Blocked
  jmp dzskip
dzbf2:
  mov dword ptr [dzblast],2
  mov dword ptr [dzbreq],0
  jmp dzskip
dzbf3:
  mov dword ptr [dzblast],3
  mov dword ptr [dzbreq],0
  jmp dzskip
dzbf4:
  mov dword ptr [dzblast],4
  mov dword ptr [dzbreq],0
  jmp dzskip
dzbf5:
  mov dword ptr [dzblast],5
  mov dword ptr [dzbreq],0
dzskip:
  popfd
  popad
  mov eax,[00A27D4C]             // original instruction
  jmp 00458BB5

dzreq:
  dd 0
dzpick:
