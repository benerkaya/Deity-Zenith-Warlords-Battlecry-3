local function rd(a)
  local v = readInteger(a)
  if v == nil then return nil end
  if v &gt;= 0x80000000 then v = v - 0x100000000 end
  return v
end
D.rd = rd

-- ===== coordinate math: edit here after a live test =====
-- Game facts (static analysis): map object = [0x74C400]; view origin tile at +0x232BF4/+0x232BF8,
-- view size in tiles at +0x232BFC/+0x232C00, map size at +0x232BE4/+0x232BE8,
-- fine scroll px at +0x232C14/+0x232C18. Tiles are 32 x 24 px. Mouse = game's own GetCursorPos (hook).
function D.view()
  local map = rd(0x0074C400)
  if map == nil or map == 0 then return nil end
  local v = {
    x = rd(map + 0x232BF4), y = rd(map + 0x232BF8),
    w = rd(map + 0x232BFC), h = rd(map + 0x232C00),
    mw = rd(map + 0x232BE4), mh = rd(map + 0x232BE8),
    fx = rd(map + 0x232C14) or 0, fy = rd(map + 0x232C18) or 0 }
  if v.x == nil or v.y == nil or v.mw == nil or v.mh == nil or v.mw &lt;= 0 or v.mh &lt;= 0 then return nil end
  return v
end
function D.clamp(v, tx, ty)
  if tx &lt; 0 then tx = 0 elseif tx &gt; v.mw - 1 then tx = v.mw - 1 end
  if ty &lt; 0 then ty = 0 elseif ty &gt; v.mh - 1 then ty = v.mh - 1 end
  return tx, ty
end
function D.cursorTile()
  local v = D.view(); if not v then return nil end
  local mx, my = rd('dzmx'), rd('dzmy')
  local ox, oy = rd('dzoffx') or 0, rd('dzoffy') or 0
  local tw, th = rd('dztw') or 32, rd('dzth') or 24
  if mx == nil or my == nil or tw &lt;= 0 or th &lt;= 0 then return nil end
  local px, py = mx - ox, my - oy
  if px &lt; 0 or py &lt; 0 then return nil end
  if v.w ~= nil and v.h ~= nil and v.w &gt; 0 and v.h &gt; 0 then
    if px &gt;= v.w * tw or py &gt;= v.h * th then return nil end -- cursor over the interface
  end
  if (rd('dzfine') or 0) ~= 0 then px = px + v.fx; py = py + v.fy end
  return D.clamp(v, v.x + px // tw, v.y + py // th)
end
function D.centerTile()
  local v = D.view(); if not v or v.w == nil or v.h == nil then return nil end
  return D.clamp(v, v.x + v.w // 2, v.y + v.h // 2)
end
-- ===== end coordinate math =====

function D.spawn()
  if getOpenedProcessID() == 0 or getAddressSafe('dzreq') == nil then return end
  if getForegroundProcess ~= nil and getForegroundProcess() ~= getOpenedProcessID() then return end
  if (rd('dzreq') or 0) &gt; 0 then writeInteger('dzlast', 8) return end
  local code = D.units[rd('dzpick') or -1]
  if code == nil then writeInteger('dzlast', 5) return end
  local tx, ty
  if rd('dzwhere') == 1 then tx, ty = D.centerTile() else tx, ty = D.cursorTile() end
  if tx == nil then writeInteger('dzlast', 6) return end
  local n = rd('dzcount') or 1
  if n &lt; 1 then n = 1 elseif n &gt; 20 then n = 20 end
  if (rd('dzsent') or 0) + n &gt; D.SESSION_CAP then writeInteger('dzlast', 7) return end
  writeInteger('dzcode', code)
  writeInteger('dzx', tx)
  writeInteger('dzy', ty)
  writeInteger('dzreq', n) -- written last: the frame hook acts on it
end

function D.bcount()
  local m = rd(0x059603D0)
  if m == nil or m == 0 then return nil end
  local w = readSmallInteger and readSmallInteger(m + 0x0C) or nil
  if w == nil then w = (rd(m + 0x0C) or 0) % 0x10000 end
  return w
end

function D.spawnB()
  if getOpenedProcessID() == 0 or getAddressSafe('dzbreq') == nil then return end
  if getForegroundProcess ~= nil and getForegroundProcess() ~= getOpenedProcessID() then return end
  if (rd('dzbreq') or 0) &gt; 0 then writeInteger('dzblast', 8) return end
  local code = D.blds[rd('dzbpick') or -1]
  if code == nil then writeInteger('dzblast', 5) return end
  local tx, ty
  if rd('dzwhere') == 1 then tx, ty = D.centerTile() else tx, ty = D.cursorTile() end
  if tx == nil then writeInteger('dzblast', 6) return end
  if (rd('dzbsent') or 0) + 1 &gt; D.BSESSION_CAP then writeInteger('dzblast', 7) return end
  D.bpend = { n = D.bcount(), t = os.clock(), f = rd('dzbsent') or 0 }
  writeInteger('dzbcode', code)
  writeInteger('dzbx', tx)
  writeInteger('dzby', ty)
  writeInteger('dzbreq', 1) -- written last: the frame hook acts on it
end

-- after a building request, see whether the game really placed it (it silently refuses blocked spots)
function D.checkB()
  local p = D.bpend
  if p == nil then return end
  local sent = rd('dzbsent') or 0
  if sent == p.f then                       -- hook has not sent it (yet), or refused it
    if (rd('dzbreq') or 0) == 0 then D.bpend = nil end
    if os.clock() - p.t &gt; 3 then D.bpend = nil end
    return
  end
  local n = D.bcount()
  if n ~= nil and p.n ~= nil and n &gt; p.n then writeInteger('dzblast', 1); D.bpend = nil return end
  if os.clock() - p.t &gt; 1.5 then writeInteger('dzblast', 9); D.bpend = nil end
end

-- level up the selected units (the frame hook does the work through the game's own XP routine)
D.MAXLEVEL = 20
function D.levelUp()
  if getOpenedProcessID() == 0 or getAddressSafe('dzlreq') == nil then return end
  local p = rd('dzlpick') or 0
  if p &lt; 1 or p &gt; D.MAXLEVEL then writeInteger('dzllast', 6) return end
  writeInteger('dzlvl', p - 1)          -- the game counts levels from 0
  writeInteger('dzlreq', 1)             -- written last: the frame hook acts on it
end
function D.levelKey()
  if getForegroundProcess ~= nil and getForegroundProcess() ~= getOpenedProcessID() then return end
  D.levelUp()
end
function D.setLKey(k)
  if D.lhk then D.lhk.destroy(); D.lhk = nil end
  D.lkey = k
  if k ~= nil and k &gt; 0 then
    D.lhk = createHotkey(function() pcall(D.levelKey) end, k)
    D.lhk.DelayBetweenActivate = 400
  end
end

-- one key: spawns whatever Type is set to
function D.press()
  if (rd('dztype') or 0) == 1 then D.spawnB() else D.spawn() end
end

function D.setKey(k)
  if D.hk then D.hk.destroy(); D.hk = nil end
  D.key = k
  if k ~= nil and k &gt; 0 then
    D.hk = createHotkey(function() pcall(D.press) end, k)
    D.hk.DelayBetweenActivate = 400
  end
end

-- the Summon record: one record, its address and list follow Type
-- (Units -&gt; dzpick + unit list, Buildings -&gt; dzbpick + building list; each keeps its own pick)
D.ROOT = 'Deity Zenith - Enable'
function D.isRoot(r)
  local d = r.Description
  return d == D.ROOT or d == 'Deity Zenith'
end

-- section header rows: plain text, they can never be ticked
D.HEADERS = { ['---Summon Units/Buildings---'] = true, ['---Level Up Selected Units---'] = true, ['---Other---'] = true }
function D.lockHeaders()
  local al = getAddressList()
  if al == nil then return end
  for i = 0, al.Count - 1 do
    local r = al[i]
    if D.HEADERS[r.Description] and r.Parent ~= nil and D.isRoot(r.Parent) then
      r.OnActivate = function(mr, before, cur) return not before end   -- refuse the tick
      if r.Active then pcall(function() r.Active = false end) end
    end
  end
end

function D.summonRec()
  local mr = D.smr
  if mr ~= nil then
    local ok, d = pcall(function() return mr.Description end)
    if ok and d == 'Summon' then return mr end
    D.smr = nil
  end
  local al = getAddressList()
  if al == nil then return nil end
  for i = 0, al.Count - 1 do
    local r = al[i]
    if r.Description == 'Summon' and r.Parent ~= nil and D.isRoot(r.Parent) then
      D.smr = r
      return r
    end
  end
  return nil
end

function D.applyType(t)
  local mr = D.summonRec()
  if mr == nil then return false end
  local addr, list
  if t == 1 then addr, list = 'dzbpick', D.bldList else addr, list = 'dzpick', D.unitList end
  if mr.DropDownList.Text ~= list then mr.DropDownList.Text = list end
  if mr.Address ~= addr then mr.Address = addr end
  return true
end

function D.syncType()
  local t = rd('dztype') or 0
  if t ~= 1 then t = 0 end
  if t ~= D.type then
    if D.applyType(t) then D.type = t end
  end
end

function D.tick()
  if getAddressSafe('dzkey') == nil then return end
  local k = rd('dzkey')
  local lk = rd('dzlkey')
  -- same key picked for both: the one changed last keeps it, the other turns Off
  if k ~= nil and k &gt; 0 and k == lk then
    if lk ~= D.lkey and k == D.key then
      writeInteger('dzkey', 0); k = 0
    else
      writeInteger('dzlkey', 0); lk = 0
    end
  end
  if k ~= D.key then D.setKey(k) end
  if lk ~= D.lkey then D.setLKey(lk) end
  pcall(D.syncType)
  pcall(D.checkB)
  local tx, ty = D.cursorTile()
  writeInteger('dzctx', tx or -1)
  writeInteger('dzcty', ty or -1)
end

function D.stop()
  if D.timer then D.timer.destroy(); D.timer = nil end
  if D.hk then D.hk.destroy(); D.hk = nil end
  if D.lhk then D.lhk.destroy(); D.lhk = nil end
  D.key = nil; D.lkey = nil; D.bpend = nil; D.type = nil
  pcall(D.applyType, 0)    -- leave the table showing the unit list (as saved)
  if getAddressSafe('dzreq') ~= nil then pcall(writeInteger, 'dzreq', 0) end
  if getAddressSafe('dzbreq') ~= nil then pcall(writeInteger, 'dzbreq', 0) end
  if getAddressSafe('dzlreq') ~= nil then pcall(writeInteger, 'dzlreq', 0) end
end

pcall(D.lockHeaders)
D.timer = createTimer(nil, false)
D.timer.Interval = 200
D.timer.OnTimer = function() pcall(D.tick) end
D.timer.Enabled = true
{$asm}

assert(00458BB0,A1 4C 7D A2 00)
alloc(dzmem,1000)
label(dzhook)
label(dzskip)
label(dzside_ok)
label(dzside_ok_pre)
label(dzf2)
label(dzf3)
label(dzf4)
label(dzf5)
label(dzreq)
label(dzpick)
label(dzside)
label(dzsidev)
label(dzcount)
label(dzwhere)
label(dzkey)
